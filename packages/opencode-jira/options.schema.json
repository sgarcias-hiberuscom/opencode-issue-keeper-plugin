{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "accounts": {
      "maxItems": 50,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "siteUrl": {
            "type": "string",
            "maxLength": 253,
            "pattern": "^https:\\/\\/[a-z0-9][a-z0-9-]*\\.atlassian\\.net\\/?$"
          },
          "auth": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "cloud-token"
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "tokenFile": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "tokenEnv": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                  }
                },
                "required": [
                  "mode",
                  "email"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "type": "string",
                    "const": "cloud-scoped-token"
                  },
                  "cloudId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "email": {
                    "type": "string",
                    "maxLength": 254,
                    "format": "email",
                    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
                  },
                  "tokenFile": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4096
                  },
                  "tokenEnv": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}$"
                  }
                },
                "required": [
                  "mode",
                  "cloudId",
                  "email"
                ],
                "additionalProperties": false
              }
            ]
          },
          "readOnly": {
            "default": true,
            "type": "boolean"
          },
          "serviceManagement": {
            "default": {},
            "type": "object",
            "properties": {
              "enabled": {
                "default": false,
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "restrictedProjects": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,39}$"
            }
          },
          "restrictedUpdateFields": {
            "default": [],
            "maxItems": 50,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:[a-zA-Z][a-zA-Z0-9_]{0,99})$"
            }
          }
        },
        "required": [
          "id",
          "siteUrl",
          "auth"
        ],
        "additionalProperties": false
      }
    },
    "defaultAccount": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,39}$"
    },
    "http": {
      "default": {},
      "type": "object",
      "properties": {
        "timeoutMs": {
          "default": 20000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 120000
        },
        "readMaxAttempts": {
          "default": 3,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 5
        },
        "maxResponseBytes": {
          "default": 1048576,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10485760
        },
        "maxConcurrentPerAccount": {
          "default": 3,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 10
        }
      },
      "additionalProperties": false
    },
    "output": {
      "default": {},
      "type": "object",
      "properties": {
        "pageSize": {
          "default": 25,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "maxPageSize": {
          "default": 100,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "maxTextChars": {
          "default": 12000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 100000
        }
      },
      "additionalProperties": false
    },
    "changes": {
      "default": {},
      "type": "object",
      "properties": {
        "ttlSeconds": {
          "default": 600,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 3600
        },
        "requireExpectedUpdated": {
          "default": true,
          "type": "boolean",
          "description": "La fase 2 exige fecha real y frescura incluso si esta opción es false; no habilita escrituras sin expectedUpdated."
        }
      },
      "additionalProperties": false
    },
    "attachments": {
      "default": {},
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "uploadRoots": {
          "default": [
            "./exports"
          ],
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        },
        "downloadDir": {
          "default": ".issuekeeper/downloads",
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "maxFileBytes": {
          "default": 20971520,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 104857600
        },
        "maxBatchBytes": {
          "default": 52428800,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 524288000
        },
        "maxFilesPerUpload": {
          "default": 5,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 20
        },
        "transferTimeoutMs": {
          "default": 120000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 600000
        },
        "overwrite": {
          "default": false,
          "type": "boolean",
          "const": false,
          "description": "Sólo false; nunca se sobrescriben descargas."
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "accounts"
  ],
  "additionalProperties": false
}
