{
  "name": "@issuekeeper/opencode-jira",
  "version": "1.0.0-rc.1",
  "private": true,
  "license": "UNLICENSED",
  "description": "Plugin de OpenCode para leer, buscar, descargar y actualizar tickets de Jira (Platform y JSM) con escritura protegida por propuesta revisable.",
  "repository": {
    "type": "git",
    "url": "https://github.com/sgarcias-hiberuscom/opencode-issue-keeper-plugin.git"
  },
  "keywords": [
    "opencode",
    "jira",
    "plugin",
    "tickets",
    "issuekeeper"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "COMPATIBILITY.md",
    "options.schema.json",
    "opencode.example.jsonc"
  ],
  "engines": {
    "node": ">=22"
  },
  "issuekeeperState": { "database": 1, "plan": 1 },
  "bin": {
    "issuekeeper-jira": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/schema.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "npm run test:mock",
    "test:mock": "vitest run test/unit test/contract test/installer --maxWorkers=2 --reporter=default --reporter=json --outputFile=reports/mock/results.json",
    "test:phase2:storage": "vitest run test/contract/persistence-prototype.test.ts test/contract/state.test.ts --maxWorkers=2",
    "test:phase2:files": "vitest run test/contract/staging.test.ts --maxWorkers=2",
    "test:phase2:functional": "vitest run test/contract/m3-functional.test.ts test/contract/m3-crash.test.ts test/unit/publication.test.ts test/unit/adf-document.test.ts --maxWorkers=2",
    "test:phase2:engine": "vitest run test/contract/application.test.ts test/contract/application-crash.test.ts test/contract/change-stack.test.ts test/contract/mutations.test.ts test/contract/multipart.test.ts test/contract/review.test.ts test/unit/metadata.test.ts test/unit/audience.test.ts test/unit/markdown.test.ts test/unit/change-schemas.test.ts --maxWorkers=2",
    "test:phase2:delivery": "vitest run test/installer test/unit/documents.test.ts test/unit/delivery.test.ts --maxWorkers=2",
    "test:phase2:campaign": "vitest run test/unit/campaign.test.ts test/unit/field-comparison.test.ts test/contract/m3-functional.test.ts --maxWorkers=2",
    "phase2:baseline": "node scripts/phase2-baseline.mjs",
    "test:live": "npm run test:live:read",
    "test:live:read": "vitest run test/integration/inventory-read.test.ts --maxWorkers=1 --reporter=default --reporter=json --outputFile=reports/live-read/results.json",
    "test:installer": "vitest run test/installer --maxWorkers=1",
    "install:global": "npm run build && node dist/cli.js install --global --source local",
    "test:pack": "npm run build && node scripts/pack-smoke.mjs",
    "test:checkout": "node scripts/checkout-smoke.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5",
    "better-sqlite3": "13.2.0",
    "jsonc-parser": "3.3.1",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-gfm-table": "2.0.0",
    "micromark-extension-gfm-table": "2.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
